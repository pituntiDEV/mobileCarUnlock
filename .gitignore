# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Metro Bundler & Cache
.metro-health-check*
.metro-cache/
metro-cache/
*.jsbundle

# Expo & EAS Build
.expo/
dist/
web-build/
.eas/

# ------------------------------------------------------------------------------
# iOS & Xcode
# ------------------------------------------------------------------------------
ios/Pods/
**/Pods/
ios/build/
**/build/
ios/DerivedData/
DerivedData/

# Xcode User Data & State
*.xcuserstate
project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# App Packaging Artifacts
*.ipa
*.app
*.dSYM.zip
*.dSYM
ios/Payload/
Payload/

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# CocoaPods
Podfile.lock.tmp

